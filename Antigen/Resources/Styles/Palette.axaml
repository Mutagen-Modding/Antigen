<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <LinearGradientBrush x:Key="TitleBarBrush"
                         StartPoint="0%,0%"
                         EndPoint="0%,100%">
        <GradientStop Color="#3D000000" Offset="0" />
        <GradientStop Color="#1A000000" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="StatusBarBrush" Color="#FFFFFF" Opacity="0.04" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" Opacity="0.03" />
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="#FFFFFF" Opacity="0.02" />
    <SolidColorBrush x:Key="RowRestBrush" Color="#22000000" />
    <SolidColorBrush x:Key="RowBorderBrush" Color="#FFFFFF" Opacity="0.06" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDF5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#DCD9E6" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8C879E" />
    <SolidColorBrush x:Key="GlyphBrush" Color="#C9C6D6" />
    <SolidColorBrush x:Key="LimeBrush" Color="#7ED321" />
    <SolidColorBrush x:Key="CloseGlyphHoverBrush" Color="#E16063" />

    <!-- Status -->
    <SolidColorBrush x:Key="StatusIdleBrush" Color="#5BB85B" />
    <SolidColorBrush x:Key="StatusBusyBrush" Color="#E6912E" />
    <SolidColorBrush x:Key="TallyNewBrush" Color="#EB9433" />

    <!-- Interaction Brushes -->
    <SolidColorBrush x:Key="ChromeHoverBrush" Color="#FFFFFF" Opacity="0.08" />
    <SolidColorBrush x:Key="ChromePressedBrush" Color="#FFFFFF" Opacity="0.14" />
    <SolidColorBrush x:Key="ChromeCloseHoverBrush" Color="#E16063" Opacity="0.22" />
    <SolidColorBrush x:Key="ChromeClosePressedBrush" Color="#E16063" Opacity="0.38" />
</ResourceDictionary>
