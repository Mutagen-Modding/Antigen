<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:plugins="clr-namespace:Mutagen.Bethesda.Plugins;assembly=Mutagen.Bethesda.Kernel"
             xmlns:viewModels="clr-namespace:Antigen.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1050"
             d:DesignHeight="600"
             x:Class="Antigen.Views.HomeView"
             x:DataType="viewModels:HomeVM"
             x:Name="Root">
    <Border Background="Transparent">
        <Grid RowDefinitions="40,*">
            <Grid Grid.Row="0"
                  x:Name="Bar"
                  Margin="8,4">
                <!-- Search Bar -->
                <TextBox VerticalAlignment="Center"
                         Text="{Binding SearchText, Delay=150}"
                         PlaceholderText="Filter mods..." />
            </Grid>

            <!-- Mod List -->
            <ScrollViewer Grid.Row="1"
                          Margin="8,0,8,8"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding FilteredModKeys}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="plugins:ModKey">
                            <Button Content="{Binding FileName}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8,6"
                                    Command="{Binding #Root.ViewModel.StartWatchingCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
