<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:viewModels="clr-namespace:Antigen.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1050"
             d:DesignHeight="30"
             x:Class="Antigen.Views.Chrome.TitleBar"
             x:DataType="viewModels:MainVM">
    <Border Height="30"
            Background="{DynamicResource TitleBarBrush}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Margin="10,0,6,0">
            <!-- Brand -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <Ellipse Width="16"
                         Height="16"
                         Stroke="{DynamicResource GlyphBrush}"
                         StrokeThickness="1.4" />

                <TextBlock Text="ANTIGEN"
                           FontSize="12"
                           FontWeight="SemiBold"
                           LetterSpacing="1.5"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Window Commands -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center">
                <Button Theme="{StaticResource ChromeFlatButton}"
                        Command="{Binding OpenProfileCommand}">
                    <TextBlock Text="{Binding ProfileName}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <Button Theme="{StaticResource ChromeFlatButton}"
                        Padding="2"
                        Command="{Binding OpenSettingsCommand}">
                    <controls:FASymbolIcon Symbol="SettingsFilled"
                                           Foreground="{DynamicResource GlyphBrush}" />
                </Button>

                <TextBlock Text="{Binding Version}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}" />

                <StackPanel Orientation="Horizontal">
                    <Button Theme="{StaticResource WindowCommandButton}"
                            Command="{Binding MinimizeCommand}">
                        <Rectangle Width="9"
                                   Height="1"
                                   Fill="{DynamicResource GlyphBrush}" />
                    </Button>

                    <Button Theme="{StaticResource WindowCommandButton}"
                            Command="{Binding ToggleMaximizeCommand}">
                        <Rectangle Width="9"
                                   Height="9"
                                   Stroke="{DynamicResource GlyphBrush}"
                                   StrokeThickness="1" />
                    </Button>

                    <Button Theme="{StaticResource WindowCommandButton}"
                            Classes="close"
                            Command="{Binding CloseCommand}">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9"
                              Stroke="{DynamicResource CloseGlyphBrush}"
                              StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
